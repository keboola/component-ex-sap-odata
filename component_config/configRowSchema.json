{
  "type": "object",
  "title": "Entity Extraction",
  "required": ["entity_set"],
  "properties": {
    "odata_version": {
      "type": "string",
      "title": "OData Version",
      "enum": ["auto", "v2", "v4"],
      "default": "auto",
      "propertyOrder": 1,
      "options": {
        "infoText": "OData protocol version. auto detects from $metadata (recommended); v2 for legacy SAP services, v4 for modern SAP services."
      }
    },
    "service_path": {
      "type": "string",
      "title": "Service Path",
      "format": "select",
      "enum": [],
      "propertyOrder": 2,
      "options": {
        "infoText": "Path to the OData service, appended to Base URL. Select from catalog or enter manually.",
        "creatable": true,
        "async": {
          "label": "Load Available Services",
          "action": "loadServices"
        }
      }
    },
    "entity_set": {
      "type": "string",
      "title": "Entity Set",
      "format": "select",
      "enum": [],
      "propertyOrder": 3,
      "options": {
        "infoText": "OData entity set to extract data from (like a database table). Select from the list or enter manually.",
        "creatable": true,
        "async": {
          "label": "Load Entity Sets",
          "action": "loadEntities",
          "autoload": true,
          "cache": true
        }
      }
    },
    "query_options": {
      "type": "object",
      "title": "Query Options (Optional)",
      "propertyOrder": 10,
      "options": {
        "infoText": "Configure field selection, filters, expansion, and ordering."
      },
      "properties": {
        "select_fields": {
          "type": "array",
          "title": "Select Fields",
          "format": "select",
          "uniqueItems": true,
          "propertyOrder": 1,
          "items": {
            "type": "string"
          },
          "options": {
            "infoText": "Specific fields to extract ($select). Leave empty to extract all fields. Reduces data transfer and API costs.",
            "tags": true,
            "async": {
              "label": "Load Fields",
              "action": "loadFields"
            }
          }
        },
        "filter_expression": {
          "type": "string",
          "title": "Filter Expression",
          "format": "textarea",
          "propertyOrder": 2,
          "options": {
            "infoText": "Filter records using OData $filter syntax. Examples: Status eq 'Active', CreatedAt gt 2024-01-01T00:00:00Z, Price le 100 and Category eq 'Electronics'."
          }
        },
        "validate_filter": {
          "type": "button",
          "title": "Validate Filter",
          "format": "sync-action",
          "propertyOrder": 3,
          "options": {
            "async": {
              "label": "Validate Filter",
              "action": "validateFilter"
            }
          }
        },
        "expand_properties": {
          "type": "array",
          "title": "Expand Navigation Properties",
          "format": "select",
          "uniqueItems": true,
          "propertyOrder": 4,
          "items": {
            "type": "string"
          },
          "options": {
            "infoText": "Related entities to include in the response ($expand). Examples: Addresses, Items, Category. Expanded data is flattened into columns.",
            "tags": true,
            "async": {
              "label": "Load Navigation Properties",
              "action": "loadNavigationProperties"
            }
          }
        }
      }
    },
    "fetching_options": {
      "type": "object",
      "title": "Fetching Options",
      "propertyOrder": 15,
      "options": {
        "infoText": "Configure how data is fetched from SAP OData API."
      },
      "properties": {
        "fetch_type": {
          "type": "string",
          "title": "Fetch Type",
          "enum": ["full", "incremental"],
          "enum_titles": ["Full Fetch (All Records)", "Incremental Fetch (Changes Only)"],
          "default": "full",
          "propertyOrder": 1,
          "options": {
            "infoText": "Full: extract all records on every run. Incremental: extract only new/changed records since the last run using a timestamp field filter."
          }
        },
        "incremental_field": {
          "type": "string",
          "title": "Incremental Field",
          "format": "select",
          "enum": [],
          "propertyOrder": 2,
          "options": {
            "infoText": "Timestamp field used to filter new/changed records. Common SAP fields: LastChangedAt, ModifiedOn, CreatedAt, SystemModstamp.",
            "creatable": true,
            "dependencies": {
              "fetch_type": "incremental"
            },
            "async": {
              "label": "Load Incremental Fields",
              "action": "loadIncrementalFields"
            }
          }
        }
      }
    },
    "destination": {
      "type": "object",
      "title": "Destination",
      "propertyOrder": 20,
      "options": {
        "infoText": "Configure output table and how data is loaded to Keboola Storage."
      },
      "properties": {
        "output_table_name": {
          "type": "string",
          "title": "Output Table Name",
          "propertyOrder": 1,
          "options": {
            "infoText": "Custom name for the output table in Keboola Storage. Defaults to the entity set name if left empty."
          }
        },
        "load_type": {
          "type": "string",
          "title": "Load Type",
          "enum": ["full", "incremental"],
          "enum_titles": ["Full Load (Replace)", "Incremental Load (Append)"],
          "default": "full",
          "propertyOrder": 2,
          "options": {
            "infoText": "Full Load: replace the entire table on each run. Incremental Load: append/upsert new data using the primary key — requires a primary key for deduplication."
          }
        },
        "primary_key": {
          "type": "array",
          "title": "Primary Key",
          "format": "select",
          "uniqueItems": true,
          "propertyOrder": 3,
          "items": {
            "type": "string"
          },
          "options": {
            "infoText": "Field(s) that uniquely identify each record — required for Incremental Load (used for upsert). Common SAP keys: BusinessPartnerID, SalesOrderID, ProductID.",
            "tags": true,
            "dependencies": {
              "load_type": "incremental"
            },
            "async": {
              "label": "Load Primary Keys",
              "action": "loadPossiblePrimaryKeys"
            }
          }
        }
      }
    },
    "advanced_options": {
      "type": "array",
      "title": "Advanced Entity Options (Optional)",
      "maxItems": 1,
      "propertyOrder": 30,
      "options": {
        "infoText": "Override pagination settings for this entity. Leave empty to use global defaults."
      },
      "items": {
        "type": "object",
        "title": "Entity-Specific Settings",
        "properties": {
          "page_size": {
            "type": "integer",
            "title": "Page Size",
            "propertyOrder": 1,
            "options": {
              "infoText": "Override the global default page size for this entity. Leave empty to use the global default."
            }
          },
          "max_records": {
            "type": "integer",
            "title": "Max Records",
            "propertyOrder": 2,
            "options": {
              "infoText": "Override the global max records limit for this entity (0 = unlimited). Leave empty to use the global default."
            }
          }
        }
      }
    },
    "preview_data": {
      "type": "button",
      "title": "Preview Data",
      "format": "sync-action",
      "propertyOrder": 100,
      "options": {
        "async": {
          "label": "Preview Data (10 records)",
          "action": "previewData"
        }
      }
    }
  }
}
