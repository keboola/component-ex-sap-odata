{
  "type": "object",
  "title": "SAP OData Connection",
  "required": [],
  "properties": {
    "connection": {
      "type": "object",
      "title": "Connection",
      "required": ["base_url"],
      "propertyOrder": 1,
      "properties": {
        "base_url": {
          "type": "string",
          "title": "Base URL",
          "propertyOrder": 1,
          "format": "url",
          "options": {
            "tooltip": "Base URL of your SAP system, without the service path. Example: `https://my-sap-server.com` or `https://sandbox.api.sap.com/s4hanacloud`.",
            "documentation": {
              "link": "https://api.sap.com/",
              "tooltip": "SAP API Hub"
            }
          }
        },
        "catalog_path": {
          "type": "string",
          "title": "Catalog Path (Optional)",
          "propertyOrder": 2,
          "options": {
            "tooltip": "Path to SAP Service Catalog for browsing available services. Example: `http/keboola/catalog`"
          }
        }
      }
    },
    "authentication": {
      "type": "object",
      "title": "Authentication",
      "required": ["auth_type"],
      "propertyOrder": 2,
      "properties": {
        "auth_type": {
          "type": "string",
          "title": "Authentication Type",
          "enum": ["basic", "oauth", "apiKey"],
          "enum_titles": ["Username & Password", "OAuth 2.0", "API Key"],
          "default": "basic",
          "propertyOrder": 1,
          "options": {
            "tooltip": "Authentication method for your SAP system. Basic (username/password) is the most common.",
            "documentation": {
              "link": "https://help.sap.com/docs/SAP_NETWEAVER_AS_ABAP_FOR_SOH_740/68bf513362174d54b58cddec28794093/e6f7c2fad4bd453eb5ee75b5d2685885.html",
              "tooltip": "SAP authentication docs"
            }
          }
        },
        "username": {
          "type": "string",
          "title": "Username",
          "propertyOrder": 2,
          "options": {
            "tooltip": "Your SAP system username.",
            "dependencies": {
              "auth_type": "basic"
            }
          }
        },
        "#password": {
          "type": "string",
          "title": "Password",
          "format": "password",
          "propertyOrder": 3,
          "options": {
            "tooltip": "Your SAP system password (encrypted and stored securely).",
            "dependencies": {
              "auth_type": "basic"
            }
          }
        },
        "#api_key": {
          "type": "string",
          "title": "API Key",
          "format": "password",
          "propertyOrder": 4,
          "options": {
            "tooltip": "API key for authentication (encrypted and stored securely).",
            "documentation": {
              "link": "https://api.sap.com/",
              "tooltip": "Get your key at api.sap.com"
            },
            "dependencies": {
              "auth_type": "apiKey"
            }
          }
        },
        "api_key_header_name": {
          "type": "string",
          "title": "API Key Header Name",
          "default": "APIKey",
          "propertyOrder": 5,
          "options": {
            "tooltip": "HTTP header name for the API key. Typically `APIKey` (SAP API Hub) or `X-API-Key` (custom gateways).",
            "dependencies": {
              "auth_type": "apiKey"
            }
          }
        },
        "token_url": {
          "type": "string",
          "title": "Token URL",
          "format": "url",
          "propertyOrder": 6,
          "options": {
            "tooltip": "OAuth 2.0 token endpoint URL for client credentials flow.",
            "dependencies": {
              "auth_type": "oauth"
            }
          }
        },
        "client_id": {
          "type": "string",
          "title": "Client ID",
          "propertyOrder": 7,
          "options": {
            "tooltip": "OAuth 2.0 client ID.",
            "dependencies": {
              "auth_type": "oauth"
            }
          }
        },
        "#client_secret": {
          "type": "string",
          "title": "Client Secret",
          "format": "password",
          "propertyOrder": 8,
          "options": {
            "tooltip": "OAuth 2.0 client secret (encrypted and stored securely).",
            "dependencies": {
              "auth_type": "oauth"
            }
          }
        },
        "test_connection": {
          "type": "button",
          "format": "test-connection",
          "propertyOrder": 9,
          "options": {
            "async": {
              "label": "Test Connection",
              "action": "testConnection"
            }
          }
        }
      }
    },
    "advanced_options": {
      "type": "object",
      "title": "Advanced Options",
      "propertyOrder": 3,
      "properties": {
        "connection_options": {
          "type": "array",
          "title": "Connection Options",
          "maxItems": 1,
          "propertyOrder": 1,
          "options": {
            "tooltip": "Override timeout, retries, and SSL settings. Leave empty to use defaults."
          },
          "items": {
            "type": "object",
            "title": "Connection Settings",
            "properties": {
              "timeout": {
                "type": "integer",
                "title": "Request Timeout (seconds)",
                "default": 60,
                "propertyOrder": 1,
                "options": {
                  "tooltip": "Maximum wait time for a SAP server response. Recommended: 60 s, for large extractions 120 s+."
                }
              },
              "max_retries": {
                "type": "integer",
                "title": "Max Retries",
                "default": 3,
                "propertyOrder": 2,
                "options": {
                  "tooltip": "Number of automatic retry attempts on transient failures (network issues, timeouts). Recommended: 3."
                }
              },
              "verify_ssl": {
                "type": "boolean",
                "title": "Verify SSL Certificates",
                "default": true,
                "propertyOrder": 3,
                "options": {
                  "tooltip": "Verify SSL/TLS certificates for HTTPS connections. Disable only for development with self-signed certificates."
                }
              }
            }
          }
        },
        "pagination_defaults": {
          "type": "array",
          "title": "Default Pagination Settings",
          "maxItems": 1,
          "propertyOrder": 2,
          "options": {
            "tooltip": "Override default page size and record limit for all entities. Leave empty to use defaults (page size: 1000, unlimited records)."
          },
          "items": {
            "type": "object",
            "title": "Pagination Settings",
            "properties": {
              "page_size": {
                "type": "integer",
                "title": "Default Page Size",
                "default": 1000,
                "propertyOrder": 1,
                "options": {
                  "tooltip": "Records per page for all entities (can be overridden per entity in row config). Recommended: 1000.",
                  "documentation": {
                    "link": "https://www.odata.org/getting-started/basic-tutorial/#queryData",
                    "tooltip": "OData query docs"
                  }
                }
              },
              "max_records": {
                "type": "integer",
                "title": "Default Max Records",
                "default": 0,
                "propertyOrder": 2,
                "options": {
                  "tooltip": "Maximum records to fetch per entity (0 = unlimited). Useful for testing or cost control."
                }
              }
            }
          }
        }
      }
    }
  }
}
