{
  "type": "object",
  "title": "SAP OData Connection",
  "required": ["base_url", "service_path", "auth_type"],
  "properties": {
    "base_url": {
      "type": "string",
      "title": "Base URL",
      "description": "Base URL of your SAP system. Examples: https://my-sap-server.com or https://sandbox.api.sap.com/s4hanacloud",
      "propertyOrder": 1,
      "format": "url"
    },
    "service_path": {
      "type": "string",
      "title": "Service Path",
      "description": "OData service path. V2 example: API_BUSINESS_PARTNER. V4 example: api_fixedassetacquisition/srvd_a2x/sap/fixedassetacquisition/0001",
      "propertyOrder": 2
    },
    "odata_version": {
      "type": "string",
      "title": "OData Version",
      "enum": ["auto", "v2", "v4"],
      "default": "auto",
      "description": "OData protocol version. Use 'auto' for automatic detection.",
      "propertyOrder": 3
    },
    "auth_type": {
      "type": "string",
      "title": "Authentication Type",
      "enum": ["basic", "oauth", "apiKey"],
      "enum_titles": ["Username & Password", "OAuth 2.0", "API Key"],
      "default": "basic",
      "propertyOrder": 10
    },
    "username": {
      "type": "string",
      "title": "Username",
      "propertyOrder": 11,
      "options": {
        "dependencies": {
          "auth_type": "basic"
        }
      }
    },
    "#password": {
      "type": "string",
      "title": "Password",
      "format": "password",
      "propertyOrder": 12,
      "options": {
        "dependencies": {
          "auth_type": "basic"
        }
      }
    },
    "#api_key": {
      "type": "string",
      "title": "API Key",
      "format": "password",
      "propertyOrder": 13,
      "options": {
        "dependencies": {
          "auth_type": "apiKey"
        }
      }
    },
    "api_key_header_name": {
      "type": "string",
      "title": "API Key Header Name",
      "default": "APIKey",
      "description": "HTTP header name for the API key (e.g., APIKey, X-API-Key, Authorization)",
      "propertyOrder": 14,
      "options": {
        "dependencies": {
          "auth_type": "apiKey"
        }
      }
    },
    "timeout": {
      "type": "integer",
      "title": "Request Timeout (seconds)",
      "default": 60,
      "propertyOrder": 20
    },
    "max_retries": {
      "type": "integer",
      "title": "Max Retries",
      "default": 3,
      "propertyOrder": 21
    },
    "verify_ssl": {
      "type": "boolean",
      "title": "Verify SSL Certificates",
      "default": true,
      "propertyOrder": 22
    },
    "page_size": {
      "type": "integer",
      "title": "Default Page Size",
      "default": 1000,
      "description": "Number of records per page (can be overridden per entity)",
      "propertyOrder": 23
    },
    "max_records": {
      "type": "integer",
      "title": "Default Max Records",
      "description": "Maximum number of records to fetch (0 = unlimited, can be overridden per entity)",
      "default": 0,
      "propertyOrder": 24
    },
    "test_connection": {
      "type": "button",
      "format": "test-connection",
      "propertyOrder": 100,
      "options": {
        "async": {
          "label": "Test Connection",
          "action": "testConnection"
        }
      }
    }
  }
}
