{
  "parameters": {
    "service_url": "https://your-sap-server/sap/opu/odata/sap/API_SALES_ORDER_SRV",
    "auth_type": "basic",
    "username": "%env(string:SAP_USERNAME)%",
    "#password": "%env(string:SAP_PASSWORD)%",
    "entity_set": "A_SalesOrder",
    "select_fields": ["SalesOrder", "SalesOrderType", "SoldToParty", "CreationDate"],
    "expand_properties": ["to_Item", "to_Partner"],
    "filter_expression": "CreationDate ge '2024-01-01'",
    "page_size": 100,
    "max_records": 100
  }
}
